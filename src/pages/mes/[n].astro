---
import Icono from '../../components/Icono.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Layout from '../../layouts/Layout.astro';
import { getCatalogo, type Capitulo } from '../../lib/catalogo';
import { rutasDeCapitulos } from '../../lib/catalogo/capitulos';
import { formatoISO, formatoRango } from '../../lib/catalogo/fechas';
import { imagenDe } from '../../lib/imagenes';
import { ruta } from '../../lib/ruta';

export async function getStaticPaths() {
	return rutasDeCapitulos((await getCatalogo()).capitulos);
}

interface Props {
	capitulo: Capitulo;
}

const { capitulo } = Astro.props;
const { perro } = await getCatalogo();
const totalFotos = capitulo.tarjetas.reduce((n, t) => n + t.fotos.length, 0);
const portada = await imagenDe((capitulo.tarjetas.find((t) => t.destacada) ?? capitulo.tarjetas[0]).fotos[0].nombre);
---

<Layout
	titulo={`${capitulo.titulo} · ${perro.nombre}`}
	descripcion={`Las ${totalFotos} fotos de ${perro.nombre} entre el ${formatoRango(capitulo.desde, capitulo.hasta)}.`}
	imagen={portada}
>
	<div class="mx-auto max-w-6xl px-4 py-16 md:px-8">
		<a
			href={ruta(`/#capitulo-${capitulo.numero}`)}
			class="inline-flex items-center gap-2 rounded-full border border-borde bg-superficie px-3 py-2 text-sm font-semibold transition duration-700 ease-fluido hover:border-acento active:scale-[0.98]"
		>
			<Icono nombre="flecha-izquierda" class="size-4" />
			Volver a la historia
		</a>

		<header class="mt-12">
			<p class="text-sm font-semibold tracking-widest text-acento uppercase">Capítulo {capitulo.numero}</p>
			<h1 class="mt-2 text-5xl font-semibold tracking-tight">{capitulo.titulo}</h1>
			<p class="mt-3 text-base text-tinta-suave">
				<time datetime={formatoISO(capitulo.desde)}>{formatoRango(capitulo.desde, capitulo.hasta)}</time>
				<span aria-hidden="true"> · </span>
				{totalFotos} fotos
			</p>
		</header>

		<ol class="mt-12 flex flex-wrap items-start gap-6" style="--alto-tarjeta: 22rem">
			{
				capitulo.tarjetas.map((tarjeta) => (
					<li class="revelar">
						<Tarjeta tarjeta={tarjeta} perro={perro.nombre} />
					</li>
				))
			}
		</ol>
	</div>
</Layout>

<script>
	import '../../scripts/rafagas';
</script>
