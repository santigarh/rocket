---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ruta } from '../lib/ruta';
import '../styles/global.css';

interface Props {
	titulo: string;
	descripcion: string;
	/** Imagen para compartir en redes (og:image). */
	imagen?: ImageMetadata;
}

const { titulo, descripcion, imagen } = Astro.props;
const base = Astro.site ?? Astro.url;
const og = imagen
	? await getImage({ src: imagen, width: Math.min(1200, imagen.width), format: 'jpeg', quality: 80 })
	: undefined;
const ogUrl = og ? new URL(og.src, base).href : undefined;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<link rel="icon" type="image/svg+xml" href={ruta('/favicon.svg')} />
		<link rel="icon" type="image/png" href={ruta('/favicon-32.png')} sizes="32x32" />
		<link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<meta name="theme-color" content="#f6f3ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#181818" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={new URL(Astro.url.pathname, base).href} />
		{ogUrl && <meta property="og:image" content={ogUrl} />}
		{og && <meta property="og:image:width" content={String(og.attributes.width)} />}
		{og && <meta property="og:image:height" content={String(og.attributes.height)} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={titulo} />
		<meta name="twitter:description" content={descripcion} />
		{ogUrl && <meta name="twitter:image" content={ogUrl} />}
	</head>
	<body class="min-h-dvh">
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 rounded-lg bg-tinta px-3 py-2 text-base font-semibold text-fondo"
		>
			Saltar al contenido
		</a>
		<slot name="cabecera" />
		<main id="contenido">
			<slot />
		</main>
		<slot name="pie" />
		<script>
			import '../scripts/revelar';
		</script>
	</body>
</html>
